{
    "annotation_avro_schema": {
        "scene_id": "str",
        "content (the entire scene content)": "str"
    },
    "scene": {
        "POST": {
            "functionality": "Creates an empty scene with the specified object if it does not exist.",
            "request": {
                "scene_id": "str",
                "collaborative": "bool",
                "models": [
                    "model"
                ]
            }
        },
        "GET": {
            "functionality": "Reads the scene_id from the url params, uses it to read and load the scene contents",
            "request": {
                "scene_id": "str"
            },
            "response": {
                "content": "str"
            },
            "fallback": "existing scene loading logic using ATON's scenehub parsing"
        },
        "PUT": {
            "functionality": "Export changes for specified scene_id and replace existing content",
            "request": {
                "scene_id": "str",
                "body": {
                    "content": "object"
                }
            },
            "fallback": "Use ATON's existing scene API to update local scene"
        }
    },
    "list_models": {
        "functionality": "Retrieve list of available models as list",
        "response": [
            "artefact.Title"
        ],
        "fallback": "List model urls from aton's internal api"
    },
    "list_schemas": {
        "functionality": "Get list of schemas",
        "response": [
            "schema.name"
        ],
        "fallback": "Read schemas from res folder"
    },
    "list_rgb_images": {
        "functionality": "Get list of rgb images",
        "response" : [
            "image_name",
            "description" 
        ],
        "fallback": "No rgb image endpoint in ATON - return empty"
    },
    "list_multispectral_images": {
        "functionality": "Get list of multispectral images",
        "response" : [
            "image_name",
            "description" 
        ],
        "fallback": "No multispectral images in ATON - return empty"
    },
    "list_sensors": {
        "functionality": "Get list of sensors",
        "response": {
            "sensors": ["sensor_id"]
        },
        "fallback": "No equivalent ATON feature - return empty"
    },
    "artefact_data": {
        "functionality": "Get everything related to the artefact, including many other fields",
        "GET": {
            "request": {
                "artefact.Title": "str",
                "data_type": "str = 'json'"
            },
            "response": {
                "artefact_data": {
                    "artefact_data": {
                        "artefact.title": "str",
                        "artefact.glb_file": "str",
                        "artefact.description": "str",
                        "artefact.owner": "str",
                        "artefact.keywords": [
                            "str",
                            "str"
                        ],
                        "artefact.copyright": "str"
                    },
                    "annotations": {
                        "artefact.annotations": "object"
                    },
                    "sensorial_data": {
                        "related_sensor_id": "str",
                        "latest_reading": "object"
                    },
                    "artefact_metadata": {
                        "artefact.metadata": "object"
                    }
                }
            },
            "fallback": "No internal replacement. Fetch scene and model from ATON, ignore other fields."
        },
        "PUT": {
            "request": {
                "artefact.Title": "str",
                "data_type": "str = 'json'",
                "artefact_data": {
                    "artefact_data": {
                        "artefact.title": "str",
                        "artefact.glb_file": "str",
                        "artefact.description": "str",
                        "artefact.owner": "str",
                        "artefact.keywords": [
                            "str",
                            "str"
                        ],
                        "artefact.copyright": "str"
                    },
                    "annotations": {
                        "artefact.annotations": "object"
                    },
                    "sensorial_data": {
                        "related_sensor_id": "str",
                        "latest_reading": "object"
                    },
                    "artefact_metadata": {
                        "artefact.metadata": "object"
                    }
                }
            },
            "fallback": "No internal replacement."
        }
    },
    "schema": {
        "functionality": "Get schema url from its name",
        "request": {
            "schema.name" : "str"
        },
        "response": {
            "schema_url": "str"
        },
        "fallback": "If list_schemas is invalid then assume we fall back to reading from res folder. Then schema name == schema url"
    },
    "metadata": {
        "functionality": "Get the metadata of a specific object as an object",
        "GET": {
            "request": {
                "artefact.Title": "str"
            },
            "response": {
                "artefact.metadata": "object"
            }
        },
        "PUT" : {
            "request": {
                "artefact.Title": "str",
                "body": "artefact.metadata"
            }
        }
    },
    "rgb_image": {
        "request": {
            "image_name": "str"
        },
        "response": {
            "image_name": "str",
            "image_url": "str",
            "description": "null for now"
        },
        "fallback" : "No rgb image endpoint in ATON - return null"
    },
    "multispectral_image": {
        "functionality": "Get set of images for multispectral viewing",
        "request": {
            "image_name": "str"
        },
        "response": {
            "image_name": "str",
            "image_url": {
                "url_for_x_nm": "str"
            },
            "description": "null for now"
        },
        "fallback" : "No rgb image endpoint in ATON - return null"
    },
    "sensor": {
        "functionality": "Get final reading object of a sensor",
        "request": {
            "sensor_id": "str",
            "per_page": 1
        },
        "response": [
            {
                "latest_reading": "object"
            }
        ],
        "fallback": "Return empty"
    },
    "authentication": {
        "POST": {
            "body": {
                "cookie": "str"
            }
        }
    }
}